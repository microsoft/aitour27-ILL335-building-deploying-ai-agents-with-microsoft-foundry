{
  "name": "AI Tour ILL335",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/azure/azure-dev/azd:0.2.0": {
      "version": "stable"
    }
  },
  "remoteUser": "vscode",
  "updateContentCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "updateContentCommand",
  "forwardPorts": [8088],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-windows-ai-studio.windows-ai-studio@prerelease"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
